rules_version = '2';

// Triple E Services - advertisements
//
//  * Anyone can read ads that are marked active (the public website).
//  * Only administrators can read inactive ads, or create / edit / delete any ad.
//  * An administrator is a signed-in user whose uid has a document in admins/.
//    admins/ can only be edited from the Firebase console, never from the website.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validAd(d) {
      return d.keys().hasOnly([
          'type', 'title', 'description', 'imageUrl', 'imagePath', 'linkUrl', 'linkText',
          'newTab', 'active', 'startAt', 'endAt', 'priority', 'frequency', 'delaySeconds',
          'createdAt', 'updatedAt'
        ])
        && d.type in ['popup', 'banner']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.description is string && d.description.size() <= 400
        && d.imageUrl is string && d.imageUrl.size() <= 1000
        && d.imagePath is string && d.imagePath.size() <= 300
        && d.linkUrl is string && d.linkUrl.size() <= 500
        && d.linkText is string && d.linkText.size() <= 30
        && d.newTab is bool
        && d.active is bool
        && (d.startAt == null || d.startAt is timestamp)
        && (d.endAt == null || d.endAt is timestamp)
        && d.priority is number
        && d.frequency in ['always', 'session', 'daily', 'weekly', 'once']
        && d.delaySeconds is number && d.delaySeconds >= 0 && d.delaySeconds <= 60
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /ads/{adId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin() && validAd(request.resource.data);
      allow delete: if isAdmin();
    }

    // A signed-in user may check only their own admin record. Nobody can write it from the site.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}

# Firebase web app config for the advertisement features.
# Copy to .env.local for local work, and add the same names as Environment Variables
# in your host (Vercel / Netlify / Replit) before building. See ADS_SETUP.md.
#
# These values identify the project; they are not secrets. Access is protected by
# firestore.rules and storage.rules. If they are left empty the site simply runs
# without ads and the /admin page shows a "not configured" notice.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
